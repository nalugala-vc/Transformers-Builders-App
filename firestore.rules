rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  // Signed-in member profile (registration, groups, contribution goal).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Per-member contribution history (home recent activity + raised total).
      match /contributions/{contributionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Church-wide totals updated when members record contributions.
    match /churchProgress/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
